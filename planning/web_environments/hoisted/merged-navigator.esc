// The merged Navigator, written the way this analysis proposes.
//
// WorkerNavigator is a strict subset of Navigator: 7 of the 11 mixins
// and 3 of the 19 own members, with no member they share differing in
// signature and nothing worker-only. So one declaration serves every
// environment and WorkerNavigator goes away.
//
// The environment lands in two places. The 4 mixins only a page has carry
// `@env("window")` where they are declared, which covers 7 members without
// annotating any of them. The other 16 are Navigator's own and are tagged
// individually, across 18 lines because two of them are overload sets.
//
// Doc comments are dropped here for readability. Planning artifact, generated
// by scripts/merge-navigator.mjs.

@env("window")
export declare interface NavigatorAutomationInformation {
    readonly webdriver: boolean
}

export declare interface NavigatorBadge {
    clearAppBadge() -> Promise<undefined>,
    setAppBadge(contents?: number) -> Promise<undefined>
}

export declare interface NavigatorConcurrentHardware {
    readonly hardwareConcurrency: number
}

@env("window")
export declare interface NavigatorContentUtils {
    registerProtocolHandler(scheme: string, url: string | url.URL) -> unknown
}

@env("window")
export declare interface NavigatorCookies {
    readonly cookieEnabled: boolean
}

export declare interface NavigatorID {
    readonly appCodeName: string,
    readonly appName: string,
    readonly appVersion: string,
    readonly platform: string,
    readonly product: string,
    readonly productSub: string,
    readonly userAgent: string,
    readonly vendor: string,
    readonly vendorSub: string
}

export declare interface NavigatorLanguage {
    readonly language: string,
    readonly languages: Array<string>
}

export declare interface NavigatorLocks {
    readonly locks: LockManager
}

export declare interface NavigatorOnLine {
    readonly onLine: boolean
}

@env("window")
export declare interface NavigatorPlugins {
    readonly mimeTypes: MimeTypeArray,
    readonly pdfViewerEnabled: boolean,
    readonly plugins: PluginArray,
    javaEnabled() -> boolean
}

export declare interface NavigatorStorage {
    readonly storage: StorageManager
}

@js("Navigator")
export declare class Navigator implements
    NavigatorBadge, NavigatorConcurrentHardware, NavigatorID, NavigatorLanguage, NavigatorLocks, NavigatorOnLine, NavigatorStorage,
    NavigatorAutomationInformation, NavigatorContentUtils, NavigatorCookies, NavigatorPlugins {
    @env("window")
    readonly clipboard: Clipboard,
    @env("window")
    readonly credentials: credentials.CredentialsContainer,
    @env("window")
    readonly doNotTrack: string | null,
    @env("window")
    readonly geolocation: Geolocation,
    @env("window")
    readonly maxTouchPoints: number,
    readonly mediaCapabilities: MediaCapabilities,
    @env("window")
    readonly mediaDevices: MediaDevices,
    @env("window")
    readonly mediaSession: MediaSession,
    readonly permissions: Permissions,
    readonly serviceWorker: service_worker.ServiceWorkerContainer,
    @env("window")
    readonly userActivation: UserActivation,
    @env("window")
    readonly wakeLock: WakeLock,
    @env("window")
    canShare(self, data?: ShareData) -> boolean,
    @env("window")
    getGamepads(self) -> mut Array<Gamepad | null>,
    @env("window")
    requestMIDIAccess(mut self, options?: MIDIOptions) -> Promise<MIDIAccess>,
    @env("window")
    requestMediaKeySystemAccess(mut self, keySystem: string, supportedConfigurations: mut Array<MediaKeySystemConfiguration>) -> Promise<MediaKeySystemAccess>,
    @env("window")
    sendBeacon(mut self, url: string | url.URL, data?: fetch.BodyInit | null) -> boolean,
    @env("window")
    share(mut self, data?: ShareData) -> Promise<undefined>,
    @env("window")
    vibrate(mut self, pattern: VibratePattern) -> boolean,
    @env("window")
    requestMediaKeySystemAccess(mut self, keySystem: string, supportedConfigurations: Iterable<MediaKeySystemConfiguration>) -> Promise<MediaKeySystemAccess>,
    @env("window")
    vibrate(mut self, pattern: Iterable<number>) -> boolean,
}
