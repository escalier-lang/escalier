// Object types are exact by default. A value may not carry fields its type does
// not declare.
type Coord = {lat: number, lng: number}

// A trailing `...` makes a type inexact. It accepts any value that has at least
// these fields.
type Located = {lat: number, lng: number, ...}

export fn format(c: Coord) -> string {
    return c.lat.toFixed(3) ++ ", " ++ c.lng.toFixed(3)
}

// Uncomment to see the error: object has extra property: alt
// val summit = format({lat: 46.852, lng: -121.760, alt: 4392})

// An exact value fits an inexact type. The reverse is rejected, since an
// inexact value may carry more fields.
export fn widen(c: Coord) -> Located {
    return c
}

// A parameter's object type is exact too. `latitude` accepts only a value with
// exactly a `lat` field. `longitude` writes a trailing `...`, so callers may
// pass objects with extra fields.
export fn latitude(p: &{lat: number}) -> number { return p.lat }
export fn longitude(p: &{lng: number, ...}) -> number { return p.lng }

// Uncomment to see the error: object has extra property: lng
// val lat = latitude(&{lat: 46.852, lng: -121.760})
export val lng = longitude(&{lat: 46.852, lng: -121.760})

// A class instance satisfies an inexact object type when its fields line up.
// An exact type rejects an instance of a class that is not `final`, since a
// subclass instance may carry more fields.
export class Landmark {
    name: string,
    lat: number,
    lng: number,
}

export fn locate(l: Landmark) -> Located {
    return l
}

// Uncomment to see the error: cannot constrain class Landmark <: exact object
// fn exactly(l: Landmark) -> {name: string, lat: number, lng: number} { return l }

// A function value is exact too. It must accept as many arguments as the
// callback slot passes, and a trailing `...` accepts the rest.
export fn formatAll(coords: &Array<Coord>) -> Array<string> {
    return coords.map(fn (c, ...) { return format(c) })
}
// Uncomment to see the error: cannot constrain function of arity 1 <: function
// of arity 3
// fn formatEach(coords: &Array<Coord>) { return coords.map(fn (c) { return format(c) }) }
