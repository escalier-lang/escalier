// Escalier infers types without annotations. Hover over any name to see the
// type the checker gave it.

// A `val` keeps the literal type of its value, since the binding can never
// change. `maxSpeed` has type `120` and `unit` has type `"km"`.
export val maxSpeed = 120
export val unit = "km"

// A `var` widens to the primitive, since it can be reassigned. `odometer` has
// type `number`.
var odometer = 0

// A function declared at module level writes its whole signature, so a caller
// can read what it does without reading its body.
export fn drive(km: number) -> number {
    odometer = odometer + km
    return odometer
}

// A closure's return type is inferred from its body. Subtracting `start` from
// `end` gives a number, so `elapsed` is
// `fn (start: number, end: number) -> number`.
export fn shiftLength(start: number, end: number) -> number {
    val elapsed = fn (start: number, end: number) {
        return end - start
    }
    return elapsed(start, end)
}

// Uncomment to see the error: cannot constrain "9:00" <: number
// val shift = shiftLength("9:00", "17:00")

// A generic function works on any type. Each call instantiates it on its own,
// so `pair` has type `[5, "five"]`.
export fn swap<A, B>(a: A, b: B) -> [B, A] {
    return [b, a]
}

export val pair = swap("five", 5)

// A callback takes its parameter types from the slot it is passed to, so `word`
// is a `string`, and the callback's return type is inferred as `number`. `map`
// calls its callback with three arguments, and the trailing `...` lets this one
// ignore the last two. Remove the `...` to see the error: cannot constrain
// function of arity 1 <: function of arity 3
export fn lengths(words: Array<string>) -> Array<number> {
    return words.map(fn (word, ...) { return word.length })
}
