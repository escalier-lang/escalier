// `MessageEvent` is in the WinterTC minimum common API, so it belongs in the
// core tier. Two of its members name the browser and are retyped here.
//
// `MessagePort` could not come with it. It reaches `StructuredSerializeOptions`
// and through it `Transferable`, which names `OffscreenCanvas`, `ImageBitmap`,
// `MediaSourceHandle` and the WebCodecs and WebRTC types.
//
// `source` is a `WindowProxy`, a `MessagePort` or a `ServiceWorker` in the
// browser and always null off it, so `null` is what every portable runtime
// reports. `ports` is an array on every runtime whose element type differs by
// runtime, so the tier names the array without the element.
//
// One class serves every tier, so a browser program reads both at their
// portable types. #1586 would let it keep its own.
export declare class MessageEvent<T = any> {
    readonly source: null,
    readonly ports: Array<unknown>,
}

// `MessageEventInit` is the argument to the `MessageEvent` constructor, so it
// carries the same two browser-typed members and takes the same retypes for the
// same reasons.
export declare interface MessageEventInit<T = any> {
    ports?: Array<unknown>,
    source?: null,
}

// `EventTarget` accepts `null` for the listener of `addEventListener` and
// `removeEventListener`, as the DOM spec declares it. A `null` listener does
// nothing: both algorithms return at once when they see it. Accepting it only
// lets a mistake through silently, so the overlay drops it.
//
// Every subclass that restates these methods, `AbortSignal` among them,
// already leaves `null` out. With `EventTarget` matching, each restatement
// accepts what the method it overrides accepts.
export declare class EventTarget {
    addEventListener(&mut self, type: string, callback: EventListenerOrEventListenerObject, options?: AddEventListenerOptions | boolean) -> undefined,
    removeEventListener(&mut self, type: string, callback: EventListenerOrEventListenerObject, options?: EventListenerOptions | boolean) -> undefined,
}

// A program implements `EventListenerObject` itself, as the object it passes to
// `addEventListener`. The runtime calls `handleEvent` and discards what it
// returns, so the return is `unknown` and a body returning a value still
// implements it.
export declare interface EventListenerObject {
    handleEvent(object: Event) -> unknown,
}
