// `Promise.reject` builds a promise that rejects, so what it rejects
// with is the type of the reason it is handed. The converted signature
// writes `-> Promise<T>`, leaving the raise slot to its `never` default
// and saying the promise never rejects — the opposite of what this
// function does.
//
// `E` defaults to `undefined` rather than `never` because `reject()`
// with no argument rejects with `undefined`. It shadows the class's own
// `E`, as `T` already shadows the class's `T`: a static binds neither,
// which is why the converter threads the raise parameter through
// instance members alone.
//
// The rest of the block settles what `then`, `catch`, and `finally`
// yield. TypeScript writes `any` for every reason and threads the
// original rejection type through unchanged, so three separate facts go
// unsaid.
//
// **A handler discharges the rejection.** After `p.catch(h)` the promise
// cannot reject with `E` any more; that is the whole point of the call.
// The same holds for the two-handler `then`. `E` survives only where
// nothing handles it.
//
// **A handler raises on its own account.** A callback that throws `F`
// makes the result reject with `F`, and a callback returning a different
// promise contributes that promise's rejection type rather than this
// one's. Each callback carries its own raise variable for both.
//
// The receiver is `self`. Attaching a handler appends to the promise's
// reaction lists, a write no reader can observe, and `mut self` would
// demand unique mutable access to attach one at all. See the `Promise`
// entry in mutability.go.
//
// **A handler is required.** TypeScript types every one of them
// `| undefined | null`, so `p.finally()` is a promise that settles the
// way `p` did and nothing else — a no-op that allocates. Requiring the
// callback costs no real call and is what lets `then` state the
// discharge rule: one overload leaves `E` alone because nothing handles
// it, the other replaces it because something does. An optional
// parameter cannot say both, and `then(null, g)` is `catch(g)` anyway.
//
// `PromiseLike` below carries the same two rules.
export declare class Promise<T, E = never> {
    static reject<T = never, E = undefined>(reason?: E) -> Promise<T, E>,
    finally<F = never>(&self, onfinally: fn () -> unknown throws F) -> Promise<T, E | F>,
    then<TResult1 = T, F = never>(&self, onfulfilled: fn (value: T) -> TResult1 | PromiseLike<TResult1, F> throws F) -> Promise<TResult1, E | F>,
    then<TResult1 = T, TResult2 = never, F = never, G = never>(&self, onfulfilled: fn (value: T) -> TResult1 | PromiseLike<TResult1, F> throws F, onrejected: fn (reason: E) -> TResult2 | PromiseLike<TResult2, G> throws G) -> Promise<TResult1 | TResult2, F | G>,
    catch<TResult = never, G = never>(&self, onrejected: fn (reason: E) -> TResult | PromiseLike<TResult, G> throws G) -> Promise<T | TResult, G>,
    constructor(&mut self, executor: fn (resolve: fn (value: T | PromiseLike<T>) -> unknown, reject: fn (reason?: E) -> unknown) -> unknown),
}

// `throw` injects an exception at the generator's suspended yield. A
// body that does not catch it rethrows it to the caller, so a value the
// caller may pass freely would escape past what `E` says this generator
// raises. Constraining the parameter to `E` is what keeps that claim
// true. TypeScript writes `e: any`, which carries no such rule. Both
// declarations below state it, the synchronous one and the async one.
export declare interface Generator<T = unknown, TReturn = any, TNext = any, E = never> {
    throw(e: E) -> IteratorResult<T, TReturn>,
}

export declare interface AsyncGenerator<T = unknown, TReturn = any, TNext = any, E = never> {
    throw(e: E) -> Promise<IteratorResult<T, TReturn>, E>,
}

// `PromiseLike.then` states the same two rules its `Promise`
// counterpart does.
export declare interface PromiseLike<T, E = never> {
    then<TResult1 = T, F = never>(onfulfilled: fn (value: T) -> TResult1 | PromiseLike<TResult1, F> throws F) -> PromiseLike<TResult1, E | F>,
    then<TResult1 = T, TResult2 = never, F = never, G = never>(onfulfilled: fn (value: T) -> TResult1 | PromiseLike<TResult1, F> throws F, onrejected: fn (reason: E) -> TResult2 | PromiseLike<TResult2, G> throws G) -> PromiseLike<TResult1 | TResult2, F | G>,
}

// The `then` operand has to be inexact. TypeScript's `{ then(…): any }` is
// width-tolerant, so the check matches any object carrying a `then` member
// whatever else it carries. The converter lowers a `.d.ts` object type literal
// to an exact Escalier object, which matches only an object holding that one
// member and nothing else, and no real thenable is that. `Awaited<T>` then took
// the `else` arm for every promise and reduced to `T` instead of unwrapping it.
// The `, ...` marker is what makes the operand say what TypeScript's says.
//
// This entry retires once the converter lowers a `.d.ts` object type literal to
// an inexact Escalier object, which is the same fix for every inline object
// annotation in the tree rather than for this one.
export declare type Awaited<T> = if T : null | undefined { T } else { if T : {...} & {
    then(onfulfilled: infer F, ...args: infer _) -> any,
    ...
} { if F : fn (value: infer V, ...args: infer _) -> any { Awaited<V> } else { never } } else { T } }

// `Array.toLocaleString` is the one member of the prelude that names a
// type another package declares. The JSDoc below carries the reason and
// reaches the generated tree. What follows is the rest of the decision.
//
// The prelude's reach is structural rather than temporary. A package it
// imports is inferred while the injection layer is still empty, so that
// package resolves none of the prelude's exports and the degraded
// surface is what the registry publishes. No import header fixes it
// later, so the alternative was to move the bags here.
//
// That would take ten declarations, since `NumberFormatOptions` names
// four option types that each name a registry. Exported, they would bind
// `NumberFormatOptionsCurrencyDisplayRegistry` in every scope, which is
// a poor trade for one parameter. Unexported, they would not inject at
// all and `std:intl` would be the package that loses them, since the
// partition gives a name one home.
//
// The overload set is restated whole because a name is what addresses
// it. Only the two-argument signature takes a JSDoc here: the no-argument
// one has upstream prose, and carryMemberDocs keeps that only while the
// overlay leaves the slot empty.
export declare class Array<T> {
    /**
     * The options bag is an inexact object. TypeScript writes
     * `Intl.NumberFormatOptions & Intl.DateTimeFormatOptions`, and both of those
     * are declared in `std:intl`, which this package cannot name. The prelude is
     * loaded before anything it could import, so an import here would resolve
     * nothing. An inexact object accepts an options bag and rejects a
     * non-object. Reach for `Intl.NumberFormat` where the checked options
     * matter.
     *
     * Change it in internal/interop/overlay/std/prelude.replace.esc.
     */
    toLocaleString(&self, locales: string | mut Array<string>, options?: {...}) -> string,
    toLocaleString(&self) -> string,
}

// TypeScript writes this as `type BuiltinIteratorReturn = intrinsic` and
// resolves it to `undefined` under `strictBuiltinIteratorReturn`, which is on
// with `strict` from TypeScript 5.6. `intrinsic` is a TypeScript compiler
// keyword with no Escalier meaning, and the converter prints a type annotation
// back out, so the alias would otherwise reach the tree naming nothing.
//
// The alias is replaced rather than dropped. Twenty interfaces across six
// packages name it, so dropping it would trade one dangling name for twenty.
export declare type BuiltinIteratorReturn = undefined

// TypeScript writes `NonNullable<T>` as `T & {}`, leaning on its own
// reading of `{}` as any value except `null` and `undefined`. Escalier's
// `{}` is the exact empty object, so the mechanical lowering computes
// the wrong set: `NonNullable<string>` would come out empty rather than
// `string`.
//
// The complement says it directly. `~(undefined | null)` admits every
// value the union rejects, so the intersection subtracts exactly the two
// members TypeScript means to exclude, primitives included.
export declare type NonNullable<T> = T & ~(undefined | null)

// A program implements `Disposable` itself, in a class whose instances it hands
// to `using` or a `DisposableStack`. The runtime calls `[Symbol.dispose]` and
// discards what it returns, so the return is `unknown` and a body returning a
// value still implements it.
export declare interface Disposable {
    [Symbol.dispose]() -> unknown
}

// A reader that accepts a `T` takes it through a binder bounded below by `T`, as
// `includes<B>(&self, searchElement: B) where T: B`, rather than as `searchElement: T`.
// `T` then occurs only in the binder's lower bound, an output position, so `Array` stays
// covariant in `T` without a special rule for `&self` methods. The call widens `B` to admit
// its argument, so `Array<number>.includes("s")` checks with `B = number | string` where
// TypeScript rejects it. A reader that builds a new array returns it over `B`, since the
// elements it holds are the receiver's and the arguments both.
//
// A replace restates every arm of the set it names, so the two cases below keep an arm the
// lower-bounded form makes redundant rather than dropping it.
//
// `find`, `findLast` and `filter` are TypeScript type-guard overloads whose `value is S`
// predicate the conversion drops. The guard's `S: T` would make `Array` invariant through a
// binder nothing narrows, so it is folded into `T`, which leaves the arm the `-> unknown`
// arm beside it with a narrower predicate type.
//
// `reduce` and `reduceRight` write their `U` arm ahead of the lower-bounded arm that also
// takes an initial value. Every call the lower-bounded arm admits the `U` arm admits, and
// tried first it would widen a `string` accumulator over `Array<number>` to
// `number | string`.
export declare class Array<T> {
    find(&self, predicate: fn (value: T, index: number, obj: &Self) -> boolean, thisArg?: unknown) -> T | undefined,
    find(&self, predicate: fn (value: T, index: number, obj: &Self) -> unknown, thisArg?: unknown) -> T | undefined,
    includes<B>(&self, searchElement: B, fromIndex?: number) -> boolean where T: B,
    findLast(&self, predicate: fn (value: T, index: number, array: &Self) -> boolean, thisArg?: unknown) -> T | undefined,
    findLast(&self, predicate: fn (value: T, index: number, array: &Self) -> unknown, thisArg?: unknown) -> T | undefined,
    toSpliced<B>(&self, start: number, deleteCount: number, ...items: mut Array<B>) -> Array<B> where T: B,
    toSpliced(&self, start: number, deleteCount?: number) -> Array<T>,
    with<B>(&self, index: number, value: B) -> Array<B> where T: B,
    concat<B>(&self, ...items: mut Array<ConcatArray<B>>) -> Array<B> where T: B,
    concat<B>(&self, ...items: mut Array<B | ConcatArray<B>>) -> Array<B> where T: B,
    indexOf<B>(&self, searchElement: B, fromIndex?: number) -> number where T: B,
    lastIndexOf<B>(&self, searchElement: B, fromIndex?: number) -> number where T: B,
    filter(&self, predicate: fn (value: T, index: number, array: &Self) -> boolean, thisArg?: unknown) -> Array<T>,
    filter(&self, predicate: fn (value: T, index: number, array: &Self) -> unknown, thisArg?: unknown) -> Array<T>,
    reduce<B>(&self, callbackfn: fn (previousValue: B, currentValue: T, currentIndex: number, array: &Self) -> B) -> B where T: B,
    reduce<U>(&self, callbackfn: fn (previousValue: U, currentValue: T, currentIndex: number, array: &Self) -> U, initialValue: U) -> U,
    reduce<B>(&self, callbackfn: fn (previousValue: B, currentValue: T, currentIndex: number, array: &Self) -> B, initialValue: B) -> B where T: B,
    reduceRight<B>(&self, callbackfn: fn (previousValue: B, currentValue: T, currentIndex: number, array: &Self) -> B) -> B where T: B,
    reduceRight<U>(&self, callbackfn: fn (previousValue: U, currentValue: T, currentIndex: number, array: &Self) -> U, initialValue: U) -> U,
    reduceRight<B>(&self, callbackfn: fn (previousValue: B, currentValue: T, currentIndex: number, array: &Self) -> B, initialValue: B) -> B where T: B,
}

// The iterator's own `reduce` and its two guard overloads are written as `Array`'s are,
// for the same reasons. `ArrayIterator`, `MapIterator` and `SetIterator` expand to this
// body, so an arm here that put `T` in an input position would make each of those
// collections invariant through its iterator.
export declare interface IteratorObject<T, TReturn = unknown, TNext = unknown> {
    filter(predicate: fn (value: T, index: number) -> boolean) -> IteratorObject<T, undefined, unknown>,
    filter(predicate: fn (value: T, index: number) -> unknown) -> IteratorObject<T, undefined, unknown>,
    reduce<B>(callbackfn: fn (previousValue: B, currentValue: T, currentIndex: number) -> B) -> B where T: B,
    reduce<U>(callbackfn: fn (previousValue: U, currentValue: T, currentIndex: number) -> U, initialValue: U) -> U,
    reduce<B>(callbackfn: fn (previousValue: B, currentValue: T, currentIndex: number) -> B, initialValue: B) -> B where T: B,
    find(predicate: fn (value: T, index: number) -> boolean) -> T | undefined,
    find(predicate: fn (value: T, index: number) -> unknown) -> T | undefined,
}
