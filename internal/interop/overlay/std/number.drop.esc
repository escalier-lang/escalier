// `Number(value)` converts a value to `number`, and converting is what the
// class is reached for. The constructor builds a wrapper object whose
// `typeof` reads `"object"` rather than `"number"`, which is a shape no
// Escalier program wants. Escalier has no `new` expression, so a plain call
// resolves against the constructor whenever one is there. Dropping it leaves
// the call signature as the only way to reach the class.
export declare interface Number {
    constructor: unknown,
}
