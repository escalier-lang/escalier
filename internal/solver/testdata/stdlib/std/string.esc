// The `String` the solver's own tests box a `string` receiver into, a hand-written
// stand-in for the committed `internal/interop/data/std/string.esc`. The members
// below are the ones the tests read.
export declare class String {
    readonly length: number,
    toUpperCase(&self) -> string,
    charAt(&self, pos: number) -> string,
    valueOf(&self) -> string,
}
