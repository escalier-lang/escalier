// The `std:prelude` the solver's own tests resolve against. Every scope starts
// with this package's exports already bound, so a test writes `Array<T>` without
// importing anything.
//
// This is a hand-written stand-in for the committed
// `internal/interop/data/std/prelude.esc`, which declares over five hundred lines
// and does not yet ingest cleanly. Reading it here would put its diagnostics in
// front of every test. The members below are the ones the tests exercise: a
// length, an element read, and a mutator that makes `T` invariant the way the
// real declaration does.
export declare class Array<T> {
    length: number,
    at(self, index: number) -> T | undefined,
    push(mut self, item: T) -> number,
    [Symbol.iterator](self) -> Iterator<T>,
}

// The `Promise` an `async fn` returns and an `await` unwraps. `E` is what the
// promise may reject with, and defaults to the `never` a promise that cannot
// reject carries. The members below are the ones the tests exercise.
export declare class Promise<T, E = never> {
    then<U, F = never>(self, onfulfilled: fn (value: T) -> U throws F) -> Promise<U, E | F>,
    catch<U, F = never>(self, onrejected: fn (reason: E) -> U throws F) -> Promise<T | U, F>,
}

// The iteration protocol. `for x in xs` reads its element type by looking up
// `[Symbol.iterator]` on the operand and reading the first type argument of what
// that member returns. `Array` declares the member so it answers the same way any
// other iterable does.
export declare interface Iterator<T, TReturn = undefined, TNext = unknown> {
    next(self, value: TNext) -> IteratorResult<T, TReturn>,
}

export declare interface Iterable<T, TReturn = undefined, TNext = unknown> {
    [Symbol.iterator](self) -> Iterator<T, TReturn, TNext>,
}
