// A field write through a `mut` reference to a class instance.
class Counter {
    count: number,
}
fn bump(mut c: Counter) {
    c.count = c.count + 1
}

// `T` sits in an input position, so it is contravariant through a mutable reference
// just as it is through an immutable one: a wider consumer fills a narrower slot.
class Consumer<T> {
    log: string,
    accept(&self, x: T) {
        return self.log
    },
}
fn feedNumber(mut c: Consumer<number>) {
    return c.accept(1)
}
fn feedEither(mut c: Consumer<number | string>) {
    return feedNumber(c)
}

// A `readonly` field is unwritable through any reference, so `T` stays covariant
// under `mut` and a narrower frozen box fills a wider slot.
class Frozen<T> {
    readonly value: T,
}
fn readEither(mut f: Frozen<number | string>) {
    return f.value
}
fn readNumber(mut f: Frozen<number>) {
    return readEither(f)
}
