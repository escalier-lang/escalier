// Basic try-catch
export val basicTryCatch = try {
    "success"
} catch {
    _ => "error"
}

// Try-catch with throw
export val tryCatchWithThrow = try {
    throw "error"
} catch {
    msg => "caught: " ++ msg
}

// Try-catch with multiple patterns
export val multipleCases = try {
    throw Error("fail")
} catch {
    Error => "caught error",
    _ => "unknown",
}

// Try-catch with pattern binding
export val patternBinding = try {
    throw "fail"
} catch {
    msg => msg,
    _ => "unknown",
}

// Try-catch with guard
export val withGuard = try {
    throw "critical"
} catch {
    err if err == "critical" => "critical error",
    _ => "other error",
}

// Try-catch in function
export fn safeDivide(a: number, b: number) -> number {
    return try {
        a / b
    } catch {
        _ => 0
    }
}

// Try-catch with object pattern
export val objectPattern = try {
    throw {message: "fail"}
} catch {
    {message: msg} => msg,
    _ => "unknown",
}

// Nested try-catch
export val nestedTryCatch = try {
    try {
        5
    } catch {
        _ => 10
    }
} catch {
    _ => 0
}

// Try-catch with block body
export val blockBody = try {
    val x = 5
    x + 10
} catch {
    _ => {
        val y = 0
        y
    }
}

// Try-catch returning different types (union)
export val mixedReturn = try {
    42
} catch {
    _ => "error"
}

// Guarded wildcard: the guard can fail, so the catch rethrows
export fn guardedWildcard(n: number) -> number throws string {
    return try {
        throw "x"
    } catch {
        _ if n > 0 => 0
    }
}

// Guarded binding: same shape, but the arm names the caught value
export fn guardedIdent(n: number) -> number throws string {
    return try {
        throw "x"
    } catch {
        e if e == "x" && n > 0 => 0
    }
}

// Catch-all ahead of a literal arm: nothing escapes, so no rethrow
export val catchAllFirst = try {
    throw "x"
} catch {
    e => e,
    "x" => "unreachable",
}

// Guarded refutable arm ahead of a catch-all: a value the pattern rejects and a
// value the guard rejects both reach the later arm
export fn guardedRefutable(n: number) -> number {
    return try {
        throw "x"
    } catch {
        "x" if n > 0 => 0,
        _ => 1,
    }
}
