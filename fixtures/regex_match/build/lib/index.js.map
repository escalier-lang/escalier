type Digits = /^\d+$/

export fn classify(s: string) {
    return match s {
        d: Digits => "digits",
        w: /^[a-z]+$/i => "word",
        _ => "other",
    }
}

export fn firstDigits(p: [string, number]) {
    return match p {
        [d: Digits, n] => n,
        _ => 0,
    }
}

type Id = /^[a-z]+$/ | Digits

export fn kind(v: string | number | boolean) {
    return match v {
        i: Id => "id",
        n: number | boolean => "scalar",
        _ => "other",
    }
}
