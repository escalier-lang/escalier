// `replace` may call its replacer with the match followed by any number of capture groups
// and offsets. An inexact replacer ignores those extra arguments, so it fills the slot.
export fn shout(s: string) -> string {
    return s.replace("b", fn (m, ...) { return m.toUpperCase() })
}

// An exact replacer accepts exactly one argument, so it is rejected.
export fn shoutExact(s: string) -> string {
    return s.replace("b", fn (m: string) { return m.toUpperCase() })
}
