// The same pair inside a namespace, for values and functions alike.
// The internal bundle assigns every member to the `geo` namespace object, so a
// bin script reaches `geo.priv` and `geo.privVal`. The public wrapper rebuilds
// `geo` from the members marked `export`, so neither reaches a consumer, and
// the .d.ts marks only those members as exported.
export fn pub() -> number {
    return 1
}

fn priv() -> number {
    return 2
}

export val pubVal = 10
val privVal = 20
