// Basic generator function
export gen fn count() {
    yield 1
    yield 2
    yield 3
}

// Generator with a return value
export gen fn countWithDone() {
    yield 1
    yield 2
    return "done"
}

// Generator that yields different types
export gen fn mixed() {
    yield 1
    yield "hello"
}

// Yield delegation using yield from
export gen fn inner() {
    yield 1
    yield 2
}

export gen fn outer() {
    yield from inner()
    yield 3
}

// Iterate over a generator using for-in
export fn sumOuter() -> number {
    var total: number = 0
    for n in outer() {
        total = total + n
    }
    return total
}

// Spread generator into array
export fn countArray() {
    return [...count()]
}

export fn outerArray() {
    return [...outer()]
}

// Async generator function
export async gen fn fetchItems() {
    yield 1
    yield 2
    yield 3
}

// Generator declared with the `gen` keyword
export gen fn genCount() {
    yield 10
    yield 20
}

// Async generator declared with `async gen`
export async gen fn genFetch() {
    yield 1
}

// Generator function expression
export val genExpr = gen fn () {
    yield "a"
}

// A `gen fn` whose body never yields is still a generator
export gen fn genNoYield() {
    return 1
}

// Drive a generator by hand. `next` takes `mut self`, so the binding is annotated
// `mut` to make the method visible.
export fn drive() {
    val it: mut Generator<1 | 2 | 3, undefined, unknown> = count()
    return it.next()
}

// The inferred send type is `unknown`, so a caller may send a value back in
export fn driveWithValue() {
    val it: mut Generator<1 | 2 | 3, undefined, unknown> = count()
    return it.next("resume")
}

// A declared send type narrows both ends. It is what `yield` evaluates to inside
// the body, and it is what `next(v)` accepts
export gen fn resumable() -> Generator<number, string, string> {
    val sent = yield 1
    return sent
}

export fn driveResumable() {
    val it: mut Generator<number, string, string> = resumable()
    return it.next("go")
}

// Delegating forwards a sent value into the delegate, so this generator's send type
// narrows to the one `resumable` declares rather than staying `unknown`
export gen fn relayResumable() {
    yield from resumable()
}
