val mut handlers: Array<fn () -> undefined> = []

export fn onClick(handler: 'static fn () -> undefined) -> undefined {
    handlers.push(handler)
}

export fn forEachItem(f: fn () -> undefined) -> undefined {
    f()
}

export fn runWith<'a>(f: 'a fn (x: number) -> number, p: &'a {x: number}) -> number {
    return f(p.x)
}

export fn setup() -> number {
    val mut count = {n: 0}
    forEachItem(fn () { count.n = count.n + 1 })
    onClick(fn () { count.n = count.n + 1 })
    val p = {x: 1}
    return runWith(fn (x) { return x + 1 }, &p)
}
