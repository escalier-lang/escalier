fn add(a: number, b: number) -> number {
    return a + b
}

fn identity<T0>(x: T0) -> T0 {
    return x
}

fn fst<T0>(a: T0, b: unknown) -> T0 {
    return a
}

fn snd<T0>(a: unknown, b: T0) -> T0 {
    return b
}

fn fstNum<A: number, B: number>(a: A, b: B) -> A { return a }
fn fstNumWrapper<T0: number>(a: T0, b: number) -> T0 { return fstNum(a, b) }

val sum = add(1, 2)
val x = identity(5)
val y = identity("hello")
val first = fst(1, "a")
val second = snd(1, "a")
val w = fstNumWrapper(1, 2)
