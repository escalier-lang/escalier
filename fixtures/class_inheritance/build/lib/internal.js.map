class Animal {
    name: string,
    constructor(mut self, name: string) {
        self.name = name
    },
    speak(self) -> string {
        return "..."
    },
    describe(self) -> string {
        return self.speak()
    },
}

class Dog extends Animal {
    breed: string,
    constructor(mut self, name: string, breed: string) {
        super(name)
        self.breed = breed
    },
    speak(self) -> string {
        return "woof"
    },
}

class Puppy extends Animal {
    constructor(mut self, named: boolean) {
        if named {
            super("rex")
        } else {
            super("stray")
        }
    },
    speak(self) -> string {
        return "yip"
    },
}

val d = Dog("rex", "lab")
val heard = d.speak()
val described = d.describe()
val named = d.name
val p = Puppy(true)
val yipped = p.speak()
