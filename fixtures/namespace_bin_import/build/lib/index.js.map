// Neither declaration carries the `export` keyword, so both are package-private.
// A bin script is part of the package, so it imports the internal bundle and
// reaches them anyway. The public wrapper leaves the `geo` object out entirely,
// because the namespace has no exported members.
class Point {
    x: number,
    y: number,
    constructor(mut self, x: number, y: number) {
        self.x = x
        self.y = y
    },
}

fn makeOrigin() -> Point {
    return Point(0, 0)
}
