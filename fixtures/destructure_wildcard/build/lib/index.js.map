val [_, second] = [1, 2]
export val fromWildcard = second

val [1, other] = [1, 2]
export val fromLiteral = other

export fn afterOne([1, b]: [number, number]) -> number {
    return b
}

export fn secondOf([_, b]: [number, number]) -> number {
    return b
}

export val secondOfClosure = fn([_, b]: [number, number]) -> number {
    return b
}

export fn sumSeconds(pairs: Array<[number, number]>) -> number {
    var sum = 0
    for [_, b] in pairs {
        sum = sum + b
    }
    return sum
}

export fn yOf({x: _, y}: {x: number, y: number}) -> number {
    return y
}

export fn othersOf({x: _, ...others}: {x: number, y: number}) -> {y: number} {
    return others
}

export fn yWhenXIsOne({x: 1, y}: {x: number, y: number}) -> number {
    return y
}
