// The stdlib declares each owned array without `mut`, so a rest
// parameter reads `...items: Array<T>` and a return reads `Array<T>`.
// The binding that receives a value decides whether it is mutable.

export fn pushAll(mut xs: Array<number>) -> Array<number> {
    xs.push(1, 2, 3)
    xs.unshift(0)
    return xs
}

export fn ofThenPush() -> number {
    val mut ys = Array.of(1, 2)
    return ys.push(3)
}

export fn concatAll(xs: Array<number>, ys: Array<number>) -> Array<number> {
    return xs.concat(ys)
}

export fn largest(a: number, b: number) -> number {
    return Math.max(a, b, 0)
}

// `Promise.all` takes `values: &mut Iterable<…>`. Its declaration does not say
// whether it writes the iterable, so the converter borrows it as `&mut`.
export async fn settle(mut ps: Array<Promise<number>>) -> Promise<number> {
    val mut results = await Promise.all(&mut ps)
    results.reverse()
    return results.length
}

export fn lower(s: string) -> string {
    return s.toLocaleLowerCase(["en-US", "fr"])
}
