{
  "name": "@escalier/runtime",
  "version": "0.0.1",
  "description": "Runtime library for the Escalier programming language",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/emit-cts-types.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "lint:package": "publint --strict && attw --pack ."
  },
  "keywords": [
    "escalier",
    "runtime",
    "programming-language",
    "typescript"
  ],
  "author": "escalier-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/escalier-lang/escalier.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/escalier-lang/escalier#readme",
  "bugs": {
    "url": "https://github.com/escalier-lang/escalier/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
