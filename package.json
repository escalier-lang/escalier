{
    "name": "escalier",
    "private": true,
    "license": "MIT",
    "version": "0.0.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/escalier-lang/escalier"
    },
    "categories": [],
    "keywords": [
        "multi-root ready"
    ],
    "scripts": {
        "vscode:prepublish": "pnpm compile",
        "compile": "pnpm lsp-server && tsc -b",
        "build": "tsc -b",
        "watch": "tsc -b -w",
        "lint": "oxlint",
        "format": "oxfmt",
        "check": "oxfmt --check && oxlint",
        "test": "vitest run",
        "changeset": "changeset",
        "version-packages": "changeset version && pnpm install --lockfile-only",
        "release": "node tools/build-binaries.mjs && pnpm --filter @escalier/cli --filter @escalier/runtime build && changeset publish",
        "test:ui": "vitest --ui --coverage",
        "coverage": "vitest run --coverage",
        "typecheck": "tsc -b"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@storybook/addon-vitest": "^10.3.3",
        "@types/node": "^20",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.10",
        "@webref/idl": "3.86.0",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "oxlint-tsgolint": "7.0.2007",
        "playwright": "^1.65.0",
        "react": "catalog:",
        "react-dom": "catalog:",
        "sloc": "^0.3.2",
        "typescript": "^5.7.2",
        "vite": "^7.3.6",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=24.4"
    },
    "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
    "dependencies": {
        "@debugmcp/mcp-debugger": "^0.17.0",
        "csstype": "^3.2.3",
        "fast-deep-equal": "^3.1.3",
        "ms": "^2.1.3"
    }
}
